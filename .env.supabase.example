# Kopier til .env.supabase (som git ignorerer) og lim inn tokenet.
# Brukes bare av: npm run supabase:oppdater
#
# Tokenet: supabase.com → klikk på kontoen øverst til høyre → Account
# preferences → Access Tokens → Generate new token. Gi det et navn som sier hva
# det er til (f.eks. «rorlager-oppdater») og en utløpsdato.
#
# OBS: et slikt token åpner ALLE prosjektene på kontoen, ikke bare rørlageret.
# Lim det aldri inn i chat, i .env (som havner i nettleseren) eller noe annet
# sted enn denne fila. Trekk det tilbake på samme side når du ikke trenger det.
SUPABASE_ACCESS_TOKEN=lim-inn-tokenet-her

# Delen foran .supabase.co i VITE_SUPABASE_URL. Skriptet stopper hvis den ikke
# er den samme som i .env, så SQL-en aldri havner i feil prosjekt.
SUPABASE_PROJECT_REF=xxnumwvkrmoqwduwmdrh
